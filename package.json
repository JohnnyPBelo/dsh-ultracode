{
  "name": "dsh-ultracode",
  "version": "1.2.1",
  "description": "UltraCode for DeepSeek Harness: a deep-work mode that routes work across models, delegates in parallel, and verifies the result before reporting it.",
  "license": "MIT",
  "type": "module",
  "main": "lib/host.js",
  "exports": {
    ".": {
      "default": "./lib/host.js"
    },
    "./delegate": {
      "default": "./lib/delegate.js"
    },
    "./invariant": {
      "default": "./lib/host-invariant.js"
    },
    "./delegate/invariant": {
      "default": "./lib/delegate-invariant.js"
    },
    "./client": {
      "default": "./client/client.js"
    },
    "./handoff": {
      "default": "./lib/types-host/handoff.js"
    },
    "./vision": {
      "default": "./lib/types-host/vision.js"
    },
    "./types": {
      "default": "./lib/types-host/types.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node tests/run.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    },
    "manifestVersion": 1
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.8 || ^0.2.1-rc.3",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.8 || ^0.2.1-rc.3",
    "@deepseek-ai/dsh-timeout": "^0.1.0-rc.8 || ^0.2.1-rc.3",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.8 || ^0.2.1-rc.3",
    "@deepseek-ai/dsh-agent": "^0.1.0-rc.8 || ^0.2.1-rc.3",
    "@deepseek-ai/dsh-commands": "^0.1.0-rc.8 || ^0.2.1-rc.3",
    "@deepseek-ai/dsh-session-projection": "^0.1.0-rc.8 || ^0.2.1-rc.3",
    "@deepseek-ai/dsh-subagent": "^0.1.0-rc.8 || ^0.2.1-rc.3",
    "@deepseek-ai/dsh-system-prompt": "^0.1.0-rc.8 || ^0.2.1-rc.3"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-agent": {
      "optional": true
    },
    "@deepseek-ai/dsh-commands": {
      "optional": true
    },
    "@deepseek-ai/dsh-session-projection": {
      "optional": true
    },
    "@deepseek-ai/dsh-subagent": {
      "optional": true
    },
    "@deepseek-ai/dsh-system-prompt": {
      "optional": true
    }
  },
  "dependencies": {
    "zod": "^4.4.3"
  }
}
